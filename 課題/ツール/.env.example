# このファイルをコピーして .env を作り、値を入れてください（.env は Git に上がりません）
# Supabase ダッシュボード → Project Settings → API で確認できます
# URL は末尾に /rest/v1/ を付けない（https://xxxxxxxx.supabase.co まで）
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon（publishable）key を入れる。service_role key は絶対に入れないこと
VITE_SUPABASE_ANON_KEY=ここにanon_keyを貼る
VITE_SUPABASE_BUCKET=images
